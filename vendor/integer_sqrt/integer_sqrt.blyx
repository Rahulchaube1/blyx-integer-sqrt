// Return the exact floor of the square root of a nonnegative integer using division-safe binary search.

pub fn integer_sqrt(number: i64) -> i64 {
    if number<0 {
        return -1;
    }
    if number<2 {
        return number;
    }
    let mut lo = 1;
    let mut hi = number/2+1;
    while lo<hi {
        let mid = lo+(hi-lo+1)/2;
        if mid <= number/mid {
            lo = mid;
        } else {
            hi = mid-1;
        }
    }
    lo
}
